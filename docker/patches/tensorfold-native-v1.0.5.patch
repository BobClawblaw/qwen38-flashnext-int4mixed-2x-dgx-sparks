+        } else if (std.mem.eql(u8, kind, "i32")) {
+            args.add(@as(i32, @intCast(o.get("value").?.integer)));
+        } else if (std.mem.eql(u8, kind, "i64")) {
+            args.add(@as(i64, o.get("value").?.integer));
+        } else if (std.mem.eql(u8, kind, "f32")) {
