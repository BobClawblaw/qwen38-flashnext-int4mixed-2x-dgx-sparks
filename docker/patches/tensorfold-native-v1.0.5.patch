+        var buf = try cuda.DeviceBuffer.alloc(t.d, @intCast(total * 4 + 64 * 256));
+        errdefer buf.free();
+        var at: u64 = buf.ptr;
+        const conv = struct {
+            fn f(kk: *kern.K, src: u64, n: i64, p: *u64) !u64 {
+                const dst = p.*;
+                p.* += std.mem.alignForward(u64, @intCast(n * 4), 256);
