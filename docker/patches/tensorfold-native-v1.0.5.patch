+    }
+
+    fn run(k: *kern.K, name: []const u8, grid: i64, block: u32, args: anytype) !void {
+        const f = try k.ext(.vision, name);
+        var a: cuda.Args = .{};
+        inline for (args) |x| a.add(x);
+        try k.go(f, grid1(grid), block, 0, &a);
+    }
