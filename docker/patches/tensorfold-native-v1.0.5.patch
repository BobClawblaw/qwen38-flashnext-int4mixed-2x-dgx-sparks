+// A 16-byte chunk c of row r sits at chunk c ^ (r % CHUNKS) so ldmatrix's eight rows hit eight bank groups.
+template <int CHUNKS>
+__device__ __forceinline__ int swz(int r, int c) { return c ^ (r % CHUNKS); }
+
+} // namespace qmm_frag
