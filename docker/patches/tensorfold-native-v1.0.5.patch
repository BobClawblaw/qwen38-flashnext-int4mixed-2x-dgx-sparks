+/// kernels/gdn.py chain (gdn_v2.prefill): the piece's rows from state_in into state_out, outputs y [n, NV, 128].
+pub fn gdnPrefill(k: *K, q: u64, kk: u64, v: u64, g: u64, beta: u64, state_in: u64, state_out: u64, y: u64, n: i64) !void {
+    if (n <= 0) return;
