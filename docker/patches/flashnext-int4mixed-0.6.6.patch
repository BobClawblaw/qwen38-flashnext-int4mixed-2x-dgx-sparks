@@ -0,0 +1,84 @@
+"""Int8 linears with group scales (affine-experts format 2): exact against the dequantized weight, row-invariant,
+mixed int8/bf16 faces, and the bf16 matmul's dispatch."""
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="the q8 kernel needs a GPU")
+
+
+def _face(n, k, gs, lo=-32, hi=32, seed=0):
+    from tensorfold.families.qwen4_exp.cuda import q8
+
+    g = torch.Generator(device="cuda").manual_seed(seed)
+    q = torch.randint(lo, hi, (n, k), dtype=torch.int8, device="cuda", generator=g)
+    s = torch.rand(n, k // gs, device="cuda", generator=g) * 0.01 + 1e-3
+    ref = (q.float().view(n, -1, gs) * s[:, :, None]).view(n, k)
+    return q8.Q8Face([q8.part_from_ints(q, s, gs)]), ref
+
+
+@pytest.mark.parametrize("n,k,gs,m", [(8240, 2560, 64, 1), (2560, 3072, 64, 16), (320, 10240, 64, 7), (1000, 2560, 128, 300)])
+def test_matches_the_dequantized_weight(n, k, gs, m) -> None:
+    from tensorfold.families.qwen4_exp.cuda import q8
+
+    face, ref = _face(n, k, gs)
+    x = (torch.randn(m, k, device="cuda") * 0.5).to(torch.bfloat16)
+    got = q8.matmul(x, face, f32=True)
+    want = x.float() @ ref.T
+    assert (got - want).abs().max().item() <= 1e-3 * want.abs().max().item()
+    bf = q8.matmul(x, face)
+    assert bf.dtype == torch.bfloat16 and torch.equal(bf, got.to(torch.bfloat16))
+
+
+def test_rows_do_not_depend_on_the_batch() -> None:
+    from tensorfold.families.qwen4_exp.cuda import q8
+
+    face, _ = _face(2560, 3072, 64)
+    x = (torch.randn(16, 3072, device="cuda")).to(torch.bfloat16)
+    full = q8.matmul(x, face, f32=True)
+    for r in (0, 5, 15):
+        assert torch.equal(q8.matmul(x[r:r + 1], face, f32=True)[0], full[r])
+
+
+def test_mixed_face_and_bf16_dispatch() -> None:
+    from tensorfold.families.qwen4_exp.cuda import bf16, q8
+
+    face, ref = _face(320, 10240, 64, -128, 128)
+    tail = torch.randn(4, 10240, device="cuda").to(torch.bfloat16)
+    mixed = bf16.stack_b16([face, bf16.b16_from_rows(tail)])
+    assert isinstance(mixed, q8.Q8Face) and mixed.n == 324 and mixed.b is mixed
+    x = torch.randn(3, 10240, device="cuda").to(torch.bfloat16)
+    out = torch.empty(3, 324, dtype=torch.float32, device="cuda")
+    bf16.matmul(x, mixed, out=out, f32=True)
+    want = torch.cat([x.float() @ ref.T, x.float() @ tail.float().T], 1)
+    assert (out - want).abs().max().item() <= 1e-3 * want.abs().max().item()
+    assert torch.allclose(mixed.dequantize(), torch.cat([ref, tail.float()]))
+
+
+@pytest.mark.parametrize("n,k,gs", [(8240, 2560, 64), (2560, 3072, 64), (324, 10240, 64), (10240, 320, 64), (124160, 2560, 128)])
+def test_prompt_sized_calls_give_decode_bits(n, k, gs) -> None:
+    """A concurrent round can put a prompt chunk beside decode rows (more than 128 rows): same bits as alone."""
+    from tensorfold.families.qwen4_exp.cuda import q8
+
+    face, _ = _face(n, k, gs)
+    x = (torch.randn(300, k, device="cuda") * 0.5).to(torch.bfloat16)
+    big = q8.matmul(x, face)
+    for r in (0, 77, 299):
+        assert torch.equal(q8.matmul(x[r:r + 1], face)[0], big[r])
+
+
+@pytest.mark.parametrize("m", [129, 2048])
+def test_hc_upmix_matches_up_then_mix(m) -> None:
+    """The fused int8 up projection + mix gives the bits of the matmul followed by ``glue.hc_mix``."""
+    from tensorfold.families.qwen4_exp.cuda import glue, q8
+
+    streams, d, k = 4, 2560, 320
+    face, _ = _face(streams * d, k, 64)
+    act = (torch.randn(m, k, device="cuda") * 0.5).to(torch.bfloat16)
+    normed = torch.randn(m, streams * d, device="cuda").to(torch.bfloat16)
+    up = q8.matmul(act, face)
+    mixed, xs = torch.empty(m, d, dtype=torch.bfloat16, device="cuda"), torch.empty(m, d // 32, device="cuda")
+    glue.hc_mix(up, normed, mixed, xs, streams)
+    mixed2, xs2 = torch.empty_like(mixed), torch.empty_like(xs)
+    assert q8.hc_upmix(act, face, normed, mixed2, xs2, streams)
+    assert torch.equal(mixed, mixed2) and torch.equal(xs.view(torch.int32), xs2.view(torch.int32))
