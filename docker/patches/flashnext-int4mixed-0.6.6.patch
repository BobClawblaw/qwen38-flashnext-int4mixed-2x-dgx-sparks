--- /dev/null
+++ b/src/tensorfold/families/qwen4_exp/cuda/affine_moe.py
@@ -0,0 +1,96 @@
+"""Flash Next's ``affine-experts`` MoE: MLX affine 4-bit routed experts on the grouped kernel, the shared expert bf16.
+
+A checkpoint whose routed experts are affine 4-bit (groups of 32 or 64) while every other linear, the shared expert
+included, is bf16: the routed experts run on the grouped MLX kernel as a table of E experts, the shared expert on the
+bf16 matmul (``bf16.matmul``, K slices summed in order), its SwiGLU rounded as the NVFP4 path rounds it. The
+selection kernel puts the shared expert's id (E) in the last slot; the routed plan is built over E experts, so that
+slot falls past the table and the plan leaves it out (``experts.cu``), exactly as the NVFP4 kernels skip it.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import torch
+import triton
+import triton.language as tl
+
+from tensorfold.cuda import experts as grouped
+from tensorfold.cuda import moe as moe_mod
+
+from . import bf16
+
+
+@triton.jit
+def _swiglu(G, OUT, g_stride, out_stride, NI: tl.constexpr, BLOCK: tl.constexpr):
+    """Row r, columns [c BLOCK, (c + 1) BLOCK): bf16(bf16(silu(gate)) * up), gate and up the bf16 halves of G."""
+    r = tl.program_id(0)
+    c = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    ok = c < NI
+    gate = tl.load(G + r * g_stride + c, mask=ok, other=0.0).to(tl.float32)
+    up = tl.load(G + r * g_stride + NI + c, mask=ok, other=0.0).to(tl.float32)
+    silu = (gate / (1.0 + tl.exp(-gate))).to(tl.bfloat16).to(tl.float32)
+    tl.store(OUT + r * out_stride + c, (silu * up).to(tl.bfloat16), mask=ok)
+
+
+@dataclass
+class MoEA:
+    """One layer's experts: the routed ones as grouped affine blocks, the shared one as bf16 rows."""
+
+    routed_experts: grouped.Experts   # E experts (no shared row)
+    shared_gu: bf16.B16               # [2 * NI, D] bf16: the gate rows, then the up rows
+    shared_down: bf16.B16             # [D, NI] bf16
+    kernel: str = "affine"
+
+    capturable = True                 # the plan stays on the device
+
+    @property
+    def routed(self) -> int:
+        return self.routed_experts.count
+
+    @property
+    def count(self) -> int:
+        return self.routed + 1
+
+    @property
+    def width(self) -> int:
+        return self.routed_experts.width
+
+    @property
+    def dims(self) -> int:
+        return self.routed_experts.dims
+
+    def nbytes(self) -> int:
+        ex = self.routed_experts
+        return (ex.up.numel() + ex.down.numel()) * 4 + self.shared_gu.nbytes() + self.shared_down.nbytes()
+
+    def shared_act(self, x: torch.Tensor, out: torch.Tensor | None = None) -> torch.Tensor:
+        """x [R, D] bf16 -> the shared expert's SwiGLU [R, NI] bf16: bf16(bf16(silu(g)) * u) on bf16 g and u, in one
+        kernel after the gate/up matmul (it was five elementwise launches)."""
+
+        g = bf16.matmul(x, self.shared_gu)
+        rows = g.shape[0]
+        if out is None:
+            out = torch.empty((rows, self.width), dtype=torch.bfloat16, device=x.device)
+        _swiglu[(rows, triton.cdiv(self.width, 512))](g, out, g.stride(0), out.stride(0), NI=self.width, BLOCK=512,
+                                                      num_warps=4)
+        return out
+
+
+def moe(x: torch.Tensor, router_rows: torch.Tensor, ex: MoEA, buf: moe_mod.MoEBuffers, top_k: int,
+        experts: int) -> moe_mod.MoEBuffers:
+    """Route x [R, D] and run its experts into buf.y [R, k + 1, D] (bf16 in prefill); slot k is the shared expert."""
+
+    rows = x.shape[0]
+    moe_mod.router(x, router_rows, buf.logits[:rows])
+    moe_mod.select_rows(buf.logits[:rows], buf, top_k, experts)
+    grouped.route(buf.pick[:rows], buf.plan_routed)      # slot k's pick is E: past the table, left out of the plan
+    prompt = buf.y.dtype != torch.float32                 # a prompt's buffers keep bf16 slots
+    grouped.gate_up(x, ex.routed_experts, buf.plan_routed, buf.act.view(-1, ex.width), rows)
+    ex.shared_act(x, out=buf.act[:rows, top_k])
+    grouped.down(buf.act.view(-1, ex.width), ex.routed_experts, buf.plan_routed, buf.y.view(-1, ex.dims), rows)
+    if getattr(ex.shared_down, "parts", None) is not None:   # int8: written straight into its slot (strided rows)
+        bf16.matmul(buf.act[:rows, top_k], ex.shared_down, out=buf.y[:rows, top_k], f32=not prompt)
+    else:
+        buf.y[:rows, top_k] = bf16.matmul(buf.act[:rows, top_k], ex.shared_down, f32=not prompt)
+    return buf
