+def rotary_inv_freq(cfg: Config) -> tuple[torch.Tensor, float]:
+    """The rotary inverse frequencies (fp32, ``rotary_dim // 2``) and the factor cos and sin are scaled by.
+
+    Default rope: ``theta ** (-i / half)`` and 1.0. With YaRN in config.json's ``rope_parameters``
+    (``rope_type: yarn``, ``factor``, ``original_max_position_embeddings``, optional ``beta_fast`` 32,
+    ``beta_slow`` 1, ``attention_factor`` or ``mscale``/``mscale_all_dim``, ``truncate`` true) the frequencies and
+    the factor follow transformers' ``_compute_yarn_parameters``: the low-frequency pairs are interpolated by
+    ``factor``, the high-frequency pairs kept, a linear ramp between the correction bounds, and the attention
+    factor defaults to ``0.1 ln(factor) + 1``. Qwen3.8 Flash Next reaches 1M tokens this way (factor 4 over its
+    262,144 trained window); a static factor also shifts short prompts, so it belongs in a long-context profile.
+    """
+
+    import math
+
+    half = cfg.rotary_dim // 2
+    dim = cfg.rotary_dim
+    base = float(cfg.rope_theta)
+    pos_freqs = torch.tensor(base, dtype=torch.float64) ** (torch.arange(0, dim, 2, dtype=torch.float64) / dim)
+    plain = 1.0 / pos_freqs
+    y = cfg.rope_scaling
+    if not y:
+        return plain.to(torch.float32), 1.0
+    original = int(y.get("original_max_position_embeddings") or 0)
+    if original <= 0:
+        raise ValueError("rope_parameters: YaRN needs original_max_position_embeddings (the trained window)")
+    factor = y.get("factor")
+    factor = float(factor) if factor is not None else None
+    if factor is None:
+        raise ValueError("rope_parameters: YaRN needs factor (the window multiplier)")
+    if factor < 1.0:
+        raise ValueError(f"rope_parameters: YaRN factor {factor} is below 1")
+
+    def mscale_of(scale: float, m: float = 1.0) -> float:
+        return 1.0 if scale <= 1 else 0.1 * m * math.log(scale) + 1.0
+
+    attention = y.get("attention_factor")
+    if attention is None:
+        ms, msa = y.get("mscale"), y.get("mscale_all_dim")
+        attention = (mscale_of(factor, float(ms)) / mscale_of(factor, float(msa))) if ms and msa else mscale_of(factor)
+    beta_fast, beta_slow = float(y.get("beta_fast") or 32), float(y.get("beta_slow") or 1)
+    truncate = bool(y.get("truncate", True))
+
+    def correction_dim(rotations: float) -> float:
+        return (dim * math.log(original / (rotations * 2 * math.pi))) / (2 * math.log(base))
+
+    low, high = correction_dim(beta_fast), correction_dim(beta_slow)
+    if truncate:
+        low, high = math.floor(low), math.ceil(high)
+    low, high = max(low, 0), min(high, dim - 1)
+    if low == high:
+        high += 0.001
+    ramp = ((torch.arange(half, dtype=torch.float64) - low) / (high - low)).clamp(0, 1)
+    extrapolation = 1 - ramp
+    inv = (plain / factor) * (1 - extrapolation) + plain * extrapolation
+    return inv.to(torch.float32), float(attention)
+
+
+def scale_rotary(w: "Weights", factor: float) -> None:
+    """Fold the rotary attention factor into the rotated dims of every attention head's norm scales.
+
+    The kernels build cos and sin from ``inv_freq`` and the position, so the factor cannot ride the frequencies;
+    rotation is linear, so scaling a query's and a key's rotated dims by it before rotation equals the reference's
+    ``cos * factor`` and ``sin * factor``. The pass-through dims stay; the indexer's queries and pooled keys take
+    it too, as the reference rotates them with the same embedding.
+    """
+
+    if factor == 1.0:
+        return
+    r = w.cfg.rotary_dim
+    layers = list(w.layers) + ([w.mtp.layer] if w.mtp is not None else [])
+    for layer in layers:
+        a = layer.attn
+        if a is None:
+            continue
+        for scale in (a.q_scale, a.k_scale, a.iq_scale, a.ik_scale):
+            scale[:r].mul_(factor)
+
+
