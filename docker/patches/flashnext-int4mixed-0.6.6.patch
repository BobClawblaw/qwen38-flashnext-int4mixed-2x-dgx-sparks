diff --git a/tests/cuda/test_flashnext_affine_experts.py b/tests/cuda/test_flashnext_affine_experts.py
new file mode 100644
index 0000000..656a585
--- /dev/null
+++ b/tests/cuda/test_flashnext_affine_experts.py
@@ -0,0 +1,112 @@
+"""affine-experts checkpoints: the routed plan leaves picks past its table out, and the shared expert runs bf16 beside it.
+
+The grouped MLX expert kernel's plan used to index every pick; an affine-experts layer's selection puts the shared
+expert's id (E) in the last slot while its routed table holds E experts, so the plan must skip that slot. The moe
+routine is then checked against a plain-torch reference on random weights."""
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="the grouped expert kernels need a GPU")
+
+
+def _plan_members(picks: torch.Tensor, experts: int, rows: int, slots: int):
+    from tensorfold.cuda import experts as grouped
+
+    plan = grouped.Plan(rows, slots, experts, picks.device)
+    grouped.route(picks, plan)
+    n_items, n_experts = (int(v) for v in plan.counts.tolist())
+    items = plan.items[:n_items].tolist()
+    members: dict[int, list[int]] = {}
+    for e, first, count in items:                          # an expert's pairs span several tiles (items)
+        members.setdefault(e, []).extend(int(plan.members[first + j]) for j in range(count))
+    return {e: sorted(m) for e, m in members.items()}, n_items
+
+
+@pytest.mark.parametrize("rows", [3, 40, 300])            # the one-block plan and the wide (ranked) plan
+def test_picks_past_the_table_are_left_out_of_the_plan(rows: int) -> None:
+    experts, slots = 6, 4
+    g = torch.Generator(device="cpu").manual_seed(rows)
+    picks = torch.randint(0, experts, (rows, slots), generator=g, dtype=torch.int32)
+    picks[:, -1] = experts                                # the shared slot: past the table
+    picks = picks.cuda()
+    got, n_items = _plan_members(picks, experts, rows, slots)
+    flat = picks.reshape(-1).tolist()
+    want = {e: sorted(p for p, pe in enumerate(flat) if pe == e) for e in range(experts)}
+    want = {e: m for e, m in want.items() if m}
+    assert got == want, "the plan's members differ from the picks below E"
+    assert all(e < experts for e in got)
+    # the same picks with the last slot inside the table: every pair placed
+    inside = picks.clone()
+    inside[:, -1] = 0
+    got2, _ = _plan_members(inside, experts, rows, slots)
+    assert sum(len(m) for m in got2.values()) == rows * slots
+    assert sum(len(m) for m in got.values()) == rows * (slots - 1)
+
+
+def _affine(w: torch.Tensor, gs: int):
+    """bf16 [N, K] -> MLX words, scales, biases (groups of gs) and the bf16 values they decode to."""
+
+    n, k = w.shape
+    g = w.float().reshape(n, k // gs, gs)
+    mn, mx = g.min(-1, keepdim=True).values, g.max(-1, keepdim=True).values
+    s = ((mx - mn) / 15).clamp(min=1e-8).to(torch.bfloat16).float()
+    b = mn.to(torch.bfloat16).float()
+    q = ((g - b) / s).round().clamp(0, 15).to(torch.int64)
+    words = (q.reshape(n, k // 8, 8) << (torch.arange(8, device=w.device) * 4)).sum(-1)
+    words = torch.where(words >= 2 ** 31, words - 2 ** 32, words).to(torch.int32)
+    deq = (q.float() * s + b).reshape(n, k)
+    return words, s.reshape(n, -1).to(torch.bfloat16), b.reshape(n, -1).to(torch.bfloat16), deq
+
+
+def test_affine_moe_matches_a_torch_reference() -> None:
+    from tensorfold.cuda import experts as grouped
+    from tensorfold.cuda import moe as moe_mod
+    from tensorfold.families.qwen4_exp.cuda import affine_moe, bf16
+
+    torch.manual_seed(0)
+    E, D, NI, top_k, rows, gs = 8, 256, 128, 3, 37, 64
+    dev = "cuda"
+    gate = [torch.randn(NI, D, device=dev).to(torch.bfloat16) * 0.05 for _ in range(E)]
+    up = [torch.randn(NI, D, device=dev).to(torch.bfloat16) * 0.05 for _ in range(E)]
+    down = [torch.randn(D, NI, device=dev).to(torch.bfloat16) * 0.05 for _ in range(E)]
+    qg, qu, qd = (list(zip(*[_affine(w, gs) for w in ws])) for ws in (gate, up, down))
+    stacked = lambda t: tuple(torch.stack(x) for x in t[:3])          # noqa: E731
+    ex = grouped.make([stacked(qg), stacked(qu)], stacked(qd), gs)
+    sg = (torch.randn(NI, D, device=dev) * 0.05).to(torch.bfloat16)
+    su = (torch.randn(NI, D, device=dev) * 0.05).to(torch.bfloat16)
+    sd = (torch.randn(D, NI, device=dev) * 0.05).to(torch.bfloat16)
+    layer = affine_moe.MoEA(ex, bf16.make_b16(torch.cat([sg, su])), bf16.make_b16(sd))
+    router = (torch.randn(E + 1, D, device=dev) * 0.1).to(torch.bfloat16)
+
+    class Cfg:
+        num_experts_per_tok, num_experts, moe_intermediate_size, hidden_size = top_k, E, NI, D
+
+    buf = moe_mod.MoEBuffers(64, Cfg, dev)
+    x = (torch.randn(rows, D, device=dev) * 0.5).to(torch.bfloat16)
+    affine_moe.moe(x, router, layer, buf, top_k, E)
+    out = moe_mod.combine(buf.y[:rows], buf.wts[:rows])
+
+    # reference: the same routing (picks and weights from the kernel), each slot in fp32 on the decoded weights
+    picks, wts = buf.pick[:rows].tolist(), buf.wts[:rows].float()
+    xf = x.float()
+    ref = torch.zeros(rows, D, device=dev)
+    for r in range(rows):
+        for k in range(top_k + 1):
+            e = picks[r][k]
+            if e < E:
+                h = torch.nn.functional.silu(xf[r] @ qg[3][e].T) * (xf[r] @ qu[3][e].T)
+                y = h @ qd[3][e].T
+            else:
+                g = (xf[r] @ sg.float().T).to(torch.bfloat16).float()
+                u = (xf[r] @ su.float().T).to(torch.bfloat16).float()
+                h = (torch.nn.functional.silu(g).to(torch.bfloat16).float() * u).to(torch.bfloat16).float()
+                y = h @ sd.float().T
+            ref[r] += wts[r, k] * y
+    assert all(picks[r][top_k] == E for r in range(rows))
+    err = (out.float() - ref).abs().max().item()
+    scale = ref.abs().max().item()
+    assert err < 0.02 * scale + 1e-3, f"affine moe differs from the reference: max err {err:.4g} on values up to {scale:.4g}"
+    # the shared slot was never touched by the grouped kernels: its activation is the bf16 shared SwiGLU
+    want_act = layer.shared_act(x)
+    assert torch.equal(buf.act[:rows, top_k], want_act)
