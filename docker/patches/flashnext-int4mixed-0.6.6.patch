@@ -0,0 +1,110 @@
+"""TENSORFOLD_STAGE_TIMES=<file>: GPU time per forward stage, from CUDA events around each stage (decode runs eager,
+no graphs, while it is set). A background thread folds finished events into totals and rewrites <file> every 5 s.
+A development tool: it changes nothing when the variable is unset."""
+
+from __future__ import annotations
+
+import functools
+import json
+import os
+import threading
+import time
+from collections import defaultdict
+
+import torch
+
+PATH = os.environ.get("TENSORFOLD_STAGE_TIMES")
+ENABLED = bool(PATH)
+SYNC = os.environ.get("TENSORFOLD_STAGE_SYNC") == "1"
+_pending: list = []
+_lock = threading.Lock()
+_totals: dict[str, list[float]] = defaultdict(lambda: [0.0, 0])
+_depth = threading.local()
+
+
+def wrap(name: str, fn):
+    if not ENABLED:
+        return fn
+
+    @functools.wraps(fn)
+    def timed(*a, **kw):
+        if torch.cuda.is_current_stream_capturing():
+            return fn(*a, **kw)
+        if SYNC:                                     # isolated cost: the stage alone, launch included
+            label = name(*a, **kw) if callable(name) else name
+            torch.cuda.synchronize()
+            t0 = time.perf_counter()
+            out = fn(*a, **kw)
+            torch.cuda.synchronize()
+            with _lock:
+                t = _totals[label]
+                t[0] += (time.perf_counter() - t0) * 1e3
+                t[1] += 1
+            return out
+        s, e = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        s.record()
+        out = fn(*a, **kw)
+        e.record()
+        with _lock:
+            _pending.append((name(*a, **kw) if callable(name) else name, s, e))
+        return out
+
+    return timed
+
+
+def _fold() -> None:
+    while True:
+        time.sleep(5)
+        with _lock:
+            done = [p for p in _pending if p[2].query()]
+            for p in done:
+                _pending.remove(p)
+        for name, s, e in done:
+            t = _totals[name]
+            t[0] += s.elapsed_time(e)
+            t[1] += 1
+        try:
+            with open(PATH, "w") as f:
+                json.dump({k: {"ms": v[0], "calls": v[1]} for k, v in sorted(_totals.items())}, f, indent=1)
+        except OSError:
+            pass
+
+
+if ENABLED:
+    threading.Thread(target=_fold, daemon=True, name="stage-times").start()
+
+
+# TENSORFOLD_PROFILE_FORWARDS=a:b: cudaProfilerStart at the a-th main forward, Stop at the b-th (an nsys capture range)
+_prof = os.environ.get("TENSORFOLD_PROFILE_FORWARDS")
+_count = [0]
+
+
+def forward_tick() -> None:
+    if not _prof:
+        return
+    a, b = (int(x) for x in _prof.split(":"))
+    _count[0] += 1
+    if _count[0] == a:
+        torch.cuda.synchronize()
+        torch.cuda.cudart().cudaProfilerStart()
+    elif _count[0] == b:
+        torch.cuda.synchronize()
+        torch.cuda.cudart().cudaProfilerStop()
+
+
+# TENSORFOLD_STAGE_REPLAY=<file>: GPU time of each decode graph replay (graphs stay on), folded like the stages
+REPLAY = os.environ.get("TENSORFOLD_STAGE_REPLAY")
+
+
+def time_replay(label: str, replay) -> None:
+    s, e = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    s.record()
+    replay()
+    e.record()
+    with _lock:
+        _pending.append((label, s, e))
+
+
+if REPLAY and not ENABLED:
+    PATH = REPLAY
+    threading.Thread(target=_fold, daemon=True, name="stage-times").start()
