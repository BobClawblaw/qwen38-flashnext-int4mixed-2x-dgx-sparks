         return int(self.trellis_bytes[list(ids)].sum())
@@ -202,6 +206,18 @@ def routed(x: torch.Tensor, pick: torch.Tensor, wts: torch.Tensor | None, ex: Ex
     return out
 
 
+def share(ex: Exl3RoutedExperts, pick: torch.Tensor, wts: torch.Tensor, pick_out: torch.Tensor | None = None,
+          wts_out: torch.Tensor | None = None) -> tuple[torch.Tensor, torch.Tensor]:
+    """A window's picks and weights as this rank sees them: picks through ``remap`` (an expert held elsewhere lands
+    on ``count``, which the kernels skip) and those slots' weights zeroed, since ``down_combine`` takes a skipped
+    slot's output from ``y`` as the caller left it. ``pick_out`` / ``wts_out`` are flat buffers of the window's size."""
+
+    local = torch.index_select(ex.remap, 0, pick.reshape(-1), out=pick_out).view(pick.shape)
+    held = local < ex.count
+    weights = torch.mul(wts, held, out=None if wts_out is None else wts_out.view(wts.shape))   # a skipped slot: 0
+    return local, weights
+
